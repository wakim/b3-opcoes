# Copie para .env e ajuste. Nenhuma chave é obrigatória para rodar a leitura local.
# Segredo nunca no config.yaml (P-B).

# Token exigido nas escritas HTTP (POST /api/*). Vazio = escritas desativadas.
APP_TOKEN=

# Raiz do lake no container (bind de ./data). Não precisa mudar.
B3_DATA_DIR=/data

# Nível de log (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO
